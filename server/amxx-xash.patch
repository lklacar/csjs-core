diff --git a/public/csjs_ip_address.h b/public/csjs_ip_address.h
new file mode 100644
index 0000000..8f34959
--- /dev/null
+++ b/public/csjs_ip_address.h
@@ -0,0 +1,35 @@
+#ifndef CSJS_IP_ADDRESS_H
+#define CSJS_IP_ADDRESS_H
+
+#include <string.h>
+
+static const size_t CSJS_IP_ADDRESS_SIZE = 64;
+
+inline char *CSJS_StripAddressPort(char *address)
+{
+	char *port;
+	if (address[0] == '[')
+	{
+		port = strchr(address + 1, ']');
+		if (!port || (port[1] && port[1] != ':'))
+		{
+			return address;
+		}
+		++address;
+	}
+	else
+	{
+		port = strchr(address, ':');
+		if (port && strchr(port + 1, ':'))
+		{
+			return address;
+		}
+	}
+	if (port)
+	{
+		*port = '\0';
+	}
+	return address;
+}
+
+#endif
